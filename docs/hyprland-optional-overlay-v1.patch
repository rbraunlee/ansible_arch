diff --git a/linux/hypr/.config/hypr/ansible_arch_optional_overlay_v1.lua b/linux/hypr/.config/hypr/ansible_arch_optional_overlay_v1.lua
new file mode 100644
index 0000000..f5fc0d7
--- /dev/null
+++ b/linux/hypr/.config/hypr/ansible_arch_optional_overlay_v1.lua
@@ -0,0 +1,24 @@
+-- ansible_arch.hyprland_optional_overlay/v1
+local home = assert(os.getenv("HOME"), "HOME is required for optional overlay")
+local overlay_path = home .. "/.config/ansible_arch/hyprland-optional.lua"
+local defaults = {
+	voxtype_enabled = false,
+	nvidia_environment = false,
+}
+
+local overlay_file = io.open(overlay_path, "r")
+if not overlay_file then
+	return defaults
+end
+overlay_file:close()
+
+local loaded, overlay = pcall(dofile, overlay_path)
+if not loaded or type(overlay) ~= "table" then
+	error("invalid ansible_arch optional overlay")
+end
+if type(overlay.voxtype_enabled) ~= "boolean"
+	or type(overlay.nvidia_environment) ~= "boolean" then
+	error("invalid ansible_arch optional overlay values")
+end
+
+return overlay
diff --git a/linux/hypr/.config/hypr/hyprland.lua b/linux/hypr/.config/hypr/hyprland.lua
